# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# API
API_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (matches docker-compose.yml)
POSTGRES_PORT=5433
DATABASE_URL=postgres://church:church@localhost:5433/church_platform?sslmode=disable
TEST_DATABASE_URL=postgres://church:church@localhost:5433/church_platform_test?sslmode=disable

# Comma-separated emails granted the Super Admin role by `pnpm db:seed`
SUPER_ADMIN_EMAILS=admin@example.com

# Cloudflare R2
R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
