{
  "name": "church-platform",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev:api": "go -C apps/api run ./cmd/api serve",
    "dev:web": "pnpm --filter @church-platform/web dev",
    "dev:admin": "pnpm --filter @church-platform/admin dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "go -C apps/api run ./cmd/api migrate",
    "db:seed": "go -C apps/api run ./cmd/api seed",
    "lint": "pnpm run lint:api && pnpm -r --if-present lint",
    "lint:api": "go -C apps/api vet ./...",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:hooks && pnpm run test:api && pnpm -r --if-present test",
    "test:hooks": "node --test \"scripts/*.test.mjs\"",
    "test:api": "go -C apps/api test ./...",
    "test:api:db": "node scripts/test-api-db.mjs",
    "build": "pnpm run build:api && pnpm -r --if-present build",
    "build:api": "go -C apps/api build -o bin/ ./cmd/api",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  }
}
