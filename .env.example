# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# API
API_ADDR=:4000
WEB_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
# Defaults to WEB_URL and ADMIN_URL
# CORS_ALLOWED_ORIGINS=
# Set when the apps share a parent domain, for example .example.org
# COOKIE_DOMAIN=

# PostgreSQL (matches docker-compose.yml)
POSTGRES_PORT=5433
DATABASE_URL=postgres://church:church@localhost:5433/church_platform?sslmode=disable
TEST_DATABASE_URL=postgres://church:church@localhost:5433/church_platform_test?sslmode=disable

# Comma-separated emails granted the Super Admin role by `pnpm db:seed`
SUPER_ADMIN_EMAILS=admin@example.com

# Cloudflare R2
R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Google sign-in, see docs/google-oauth-setup.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/api/v1/auth/google/callback
